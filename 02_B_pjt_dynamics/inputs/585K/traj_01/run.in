# GPUMD: time-resolved local PJT-vector dynamics
# T=585 K, replica=01; no generic phonon/current spectrum is recomputed.
potential       nep.txt
velocity        585 seed 15851
time_step       0.5

# NVT equilibration: 200 ps
ensemble        nvt_nhc 585 585 100
run             400000

# NVE production: 100 ps; positions every 20 fs (40 steps)
# dump_exyz is non-propagating and applies only to this production run.
ensemble        nve
dump_exyz       40 0
dump_thermo     2000
run             200000
