# GPUMD VACF: T=620K, Volume=V0
# compute_dos → PDOS → Grüneisen γ(ω)
potential       nep.txt
velocity        620  seed  31086
time_step       1

# ---- Nose-Hoover chain 预平衡 (100 ps) ----
ensemble        nvt_nhc 620 620 100
run             100000

# ---- 生产运行 (500 ps, compute_dos) ----
ensemble        nvt_nhc 620 620 100
compute_dos     5 2000 80 num_dos_points 2000
run             500000
