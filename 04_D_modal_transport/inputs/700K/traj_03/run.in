# GPUMD GKMA: T=700K, Traj=03
# compute_gkma → Green-Kubo Modal Analysis (κ mode decomposition)
# NEP cutoff: r_cut = 8.0 A (radial + angular)
potential       nep.txt

velocity        700  seed  224563
time_step       0.5              # fs

# ---- NVT-NHC equilibration (200 ps) ----
ensemble        nvt_nhc 700 700 100
run             400000

# ---- NVE production with modal heat current (5 ns) ----
# NVE production for equilibrium heat-current correlations
# compute_gkma samples modal heat current every 100 steps (50 fs)
ensemble        nve
compute_gkma    100 1 2058 bin_size 1
run             10000000
