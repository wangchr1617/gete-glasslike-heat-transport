# GPUMD Modal SHC: T=500K, Traj=02
# compute_gkma → Green-Kubo Modal Analysis (κ mode decomposition)
# NEP cutoff: r_cut = 8.0 A (radial + angular)
potential       nep.txt

velocity        500  seed  103847
time_step       0.5              # fs (NEP r_cut=8A requires fine time step)

# ---- NVT-NHC equilibration (200 ps) ----
ensemble        nvt_nhc 500 500 100
run             400000

# ---- NVE production with Modal SHC (5 ns) ----
# NVE ensemble REQUIRED: thermostat would distort phonon populations
# compute_gkma samples modal heat current every 100 steps (50 fs)
ensemble        nve
compute_gkma    100 1 2058 bin_size 1
run             10000000
