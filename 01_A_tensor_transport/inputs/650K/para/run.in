# GPUMD HNEMD: Para (Fe||z)
# Temperature = 650 K  |  Driving force = (0.0e+00, 0.0e+00, 2.0e-04) 1/A
# Total steps = 10000000  |  Output interval = 1000
potential       nep.txt
velocity        650  seed  88025
time_step       1

# ---- Nose-Hoover chain 预平衡 (无 dump_exyz) ----
ensemble        nvt_nhc 650 650 100
run             100000

# ---- HNEMD 生产运行 (无 dump_exyz) ----
ensemble        nvt_nhc 650 650 100
compute_hnemd   1000 0.0 0.0 0.0002
run             10000000
